{
  "description": "GuardRail: company policy for Claude Code. 74 rules across databases, infrastructure, cloud, Kubernetes, files, Git, external APIs, secrets, supply chain and production, with an audit log and live dashboard.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "java",
            "args": ["${CLAUDE_PLUGIN_ROOT}/src/GuardRail.java", "prompt", "${CLAUDE_PLUGIN_ROOT}/policy.json"],
            "timeout": 30,
            "statusMessage": "GuardRail: checking prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "java",
            "args": ["${CLAUDE_PLUGIN_ROOT}/src/GuardRail.java", "check", "${CLAUDE_PLUGIN_ROOT}/policy.json"],
            "timeout": 60,
            "statusMessage": "GuardRail: checking policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|WebFetch|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "java",
            "args": ["${CLAUDE_PLUGIN_ROOT}/src/GuardRail.java", "audit", "${CLAUDE_PLUGIN_ROOT}/policy.json"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(?!(Bash|PowerShell|WebFetch|Write|Edit|MultiEdit|NotebookEdit)$).*",
        "hooks": [
          {
            "type": "command",
            "command": "java",
            "args": ["${CLAUDE_PLUGIN_ROOT}/src/GuardRail.java", "audit", "${CLAUDE_PLUGIN_ROOT}/policy.json"],
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "java",
            "args": ["${CLAUDE_PLUGIN_ROOT}/src/GuardRail.java", "failure", "${CLAUDE_PLUGIN_ROOT}/policy.json"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
